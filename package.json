{
  "name": "termview",
  "version": "1.0.0",
  "description": "CLI Virtual Phone Preview Tool - Real-time mobile previews in your terminal",
  "main": "dist/index.js",
  "bin": {
    "termview": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "cli",
    "mobile",
    "preview",
    "hot-reload",
    "terminal",
    "development"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chokidar": "^3.6.0",
    "commander": "^14.0.3",
    "ink": "^6.8.0",
    "picocolors": "^1.1.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "ws": "^8.21.1"
  }
}
